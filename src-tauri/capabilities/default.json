{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:allow-destroy",
    "core:window:allow-close",
    "pty:allow-spawn",
    "pty:default",
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "fs:read-all",
    "fs:write-all",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-watch",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APP_CONFIG_DIR/**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    "process:default",
    "shell:default",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "kill-process",
          "cmd": "kill",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "ps",
          "cmd": "ps",
          "args": true
        },
        {
          "name": "/bin/zsh",
          "cmd": "/bin/zsh",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "/bin/zsh",
          "cmd": "/bin/zsh",
          "args": true
        },
        {
          "name": "sh .start.run.sh",
          "cmd": "sh",
          "args": [
            ".start.run.sh"
          ]
        },
        {
          "name": "sh start.sh",
          "cmd": "sh",
          "args": [
            "start.sh"
          ]
        },
        {
          "name": "yarn start",
          "cmd": "yarn",
          "args": [
            "start"
          ]
        }
      ]
    },
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:*"
        }
      ]
    },
    "os:default",
    "log:allow-log",
    "log:default"
  ]
}